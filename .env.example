# ---------------------------------------------------------------------------
# Business Credit Platform — environment template  (TASK-01)
#
# Copy to `.env` for local development. NEVER commit a real secret.
# Production values live in Vercel encrypted env vars (web) and the worker
# host's secret store (worker). One isolated credential set per environment —
# a production Stripe or bureau key in staging is a reportable incident.
#
# packages/config validates these at boot and FAILS FAST when a required key
# is missing, rather than surfacing a confusing runtime error later.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# development | staging | production — drives which guardrails are enforced.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Machai

# --- Database (managed Postgres, e.g. Neon or Supabase) ----------------------
# Use the POOLED endpoint from the web app: Vercel functions open many
# short-lived connections and will exhaust an unpooled Postgres.
DATABASE_URL=postgresql://user:password@host:5432/machai?sslmode=require
# Direct (unpooled) endpoint — migrations only.
DATABASE_URL_UNPOOLED=

# --- Redis (cache, sessions, BullMQ queue) -----------------------------------
REDIS_URL=redis://localhost:6379

# --- Field-level encryption (EIN / any SSN) ----------------------------------
# Local dev: a 32-byte base64 key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Staging/production: set ENCRYPTION_PROVIDER=kms and supply the KMS key id so
# the data key is wrapped by KMS (envelope encryption) instead of a local key.
ENCRYPTION_PROVIDER=local
ENCRYPTION_KEY=
KMS_KEY_ID=

# --- Session / auth ----------------------------------------------------------
# 32+ byte random string; rotates all sessions when changed.
SESSION_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=720

# --- Stripe ------------------------------------------------------------------
# Test-mode keys everywhere except production.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- Object storage (S3 / Cloudflare R2) — private ACL, signed URLs only ------
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Email (Resend / Postmark / SES) -----------------------------------------
# Unset EMAIL_PROVIDER falls back to the console adapter in development.
EMAIL_PROVIDER=console
EMAIL_FROM="Machai <no-reply@example.com>"
RESEND_API_KEY=

# --- Bureau data (Direction A — PULLING reports) -----------------------------
# mock  = deterministic fixture client, safe for dev/staging and for building
#         against while the data agreement is unsigned (STATE.md §6).
# live  = real provider credentials. Do NOT set until the pull data agreement
#         is signed — permissible-use terms apply.
BUREAU_MODE=mock
CREDITSAFE_API_URL=
CREDITSAFE_API_KEY=
EQUIFAX_BUSINESS_API_URL=
EQUIFAX_BUSINESS_API_KEY=
DNB_API_URL=
DNB_API_KEY=
EXPERIAN_BUSINESS_API_URL=
EXPERIAN_BUSINESS_API_KEY=

# --- Bureau reporting claims (Direction B — FURNISHING) ----------------------
# These gate every "reports to X bureau" statement in marketing AND the
# dashboard. They MUST stay false until that bureau's data-furnisher
# agreement is approved. Spec §12.4, TASK-06. Legal/Compliance owns these.
REPORTING_LIVE_CREDITSAFE=false
REPORTING_LIVE_EQUIFAX_BUSINESS=false
REPORTING_LIVE_DNB=false
REPORTING_LIVE_EXPERIAN_BUSINESS=false

# --- KYB (Know Your Business) ------------------------------------------------
# manual = staff review queue (the v1 default, decision D3).
KYB_PROVIDER=manual
KYB_API_KEY=

# --- Spam protection (contact form + signup) ---------------------------------
# Unset = honeypot + timing checks only. Set for CAPTCHA enforcement.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# --- Worker tier -------------------------------------------------------------
WORKER_PORT=3001
# Shared secret so only the worker host can call privileged internal endpoints.
WORKER_INTERNAL_TOKEN=
